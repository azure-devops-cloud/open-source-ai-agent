# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider
# Local, fully open-source path:
AI_PROVIDER=ollama
AI_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional: free-tier hosted inference using an open model on Groq.
# Groq's API is OpenAI-compatible; the model remains open-weight.
# AI_PROVIDER=groq
# AI_MODEL=qwen/qwen3.6-27b
# GROQ_API_KEY=

# Generic OpenAI-compatible provider
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
